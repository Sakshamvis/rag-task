# Sarvam AI — speech-to-text (required for voice)
SARVAM_API_KEY=

# Optional generative LLM (Groq). If empty, extractive answers are used (faster, hits <200ms).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional OpenAI-compatible base (alternative to Groq)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Index
INDEX_DIR=data/index
MAX_CORPUS_QUERIES=800
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Guardrails
# Dense cosine similarity floor (not RRF rank score)
MIN_RETRIEVAL_SCORE=0.18
GROUNDING_OVERLAP_MIN=0.08
